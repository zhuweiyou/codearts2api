{
  "name": "codearts2api",
  "version": "0.1.0",
  "private": true,
  "description": "把 dsh-providers-hub 的 Jet Hub 多渠道管理 + OpenAI 网关搬到独立后端（不依赖 DSH 宿主）",
  "type": "module",
  "main": "dist-server/index.js",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node dist-server/index.js",
    "dev": "node --watch --import vite-plus/register src/index.ts",
    "dev:web": "vp dev",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vp build",
    "build:server": "tsc -p tsconfig.server.json",
    "pretest": "pnpm run build:web",
    "preview": "vp preview",
    "test": "vp test run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "cookie-parser": "^1.4.7",
    "dsh-providers-hub": "git+https://github.com/iJetLi/dsh-providers-hub.git#9becd8cc21c1da1eb065c6fc0ff1d6b519e89104",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5",
    "typescript": "^7.0.2",
    "vite-plus": "1.6.0",
    "zustand": "^5.1.0"
  }
}
