{
  "name": "codearts2api",
  "version": "0.1.0",
  "private": true,
  "description": "把 deepseek-harness-codearts 的 Jet Hub 多渠道管理 + OpenAI 网关搬到独立后端（不依赖 DSH 宿主）",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "dsh-codearts-auth": "git+https://gitee.com/iJetLi/deepseek-harness-codearts.git#04de37c12528a177751d35844bd2bcdfb80ef8f4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
